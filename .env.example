# Find & Lost Root Environment Configuration

# Backend
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/findlost
JWT_SECRET=super-secret-findlost-token-key-change-in-production

# Local Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# Image Uploads
UPLOAD_DIR=./uploads

# Mobile Client
EXPO_PUBLIC_API_URL=http://localhost:5000/api
