datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  phone        String?
  avatar       String?
  isVerified   Boolean        @default(true)
  lastActive   DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lostItems    LostItem[]
  foundItems   FoundItem[]
  lostMatches  Match[]        @relation("LostUserMatches")
  foundMatches Match[]        @relation("FoundUserMatches")
  messages     Message[]      @relation("SentMessages")
  notifications Notification[]

  @@map("users")
}

model LostItem {
  id                         String    @id @default(uuid())
  userId                     String
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                      String
  description                String
  category                   String
  brand                      String?
  model                      String?
  color                      String
  distinctiveFeatures        String[]  @default([])
  lostDate                   DateTime
  latitude                   Float
  longitude                  Float
  address                    String?
  city                       String
  state                      String?
  country                    String?
  approximateArea            String
  images                     String[]  @default([])
  status                     String    @default("ACTIVE")
  aiDescription              String?
  aiAnalysis                 Json?
  privateVerificationDetails String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  matches                    Match[]

  @@map("lost_items")
}

model FoundItem {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  description         String
  category            String
  brand               String?
  model               String?
  color               String
  distinctiveFeatures String[]  @default([])
  foundDate           DateTime
  latitude            Float
  longitude           Float
  address             String?
  city                String
  state               String?
  country             String?
  approximateArea     String
  images              String[]  @default([])
  status              String    @default("ACTIVE")
  aiDescription       String?
  aiAnalysis          Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  matches             Match[]

  @@map("found_items")
}

model Match {
  id                         String       @id @default(uuid())
  lostItemId                 String
  lostItem                   LostItem     @relation(fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItemId                String
  foundItem                  FoundItem    @relation(fields: [foundItemId], references: [id], onDelete: Cascade)
  lostUserId                 String
  lostUser                   User         @relation("LostUserMatches", fields: [lostUserId], references: [id], onDelete: Cascade)
  foundUserId                String
  foundUser                  User         @relation("FoundUserMatches", fields: [foundUserId], references: [id], onDelete: Cascade)
  matchScore                 Float
  visualSimilarity           Float        @default(0)
  categorySimilarity         Float        @default(0)
  colorSimilarity            Float        @default(0)
  brandSimilarity            Float        @default(0)
  locationSimilarity         Float        @default(0)
  dateSimilarity             Float        @default(0)
  descriptionSimilarity      Float        @default(0)
  aiReasoning                String[]     @default([])
  status                     String       @default("POTENTIAL")
  verificationStatus         String       @default("NONE")
  verificationQuestion       String?
  verificationAnswerProvided String?
  meetingLocation            String?
  meetingTime                String?
  confirmedByOwner           Boolean      @default(false)
  confirmedByFinder          Boolean      @default(false)
  handoverCompleted          Boolean      @default(false)
  notes                      String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  conversation               Conversation?

  @@map("matches")
}

model Conversation {
  id             String    @id @default(uuid())
  matchId        String    @unique
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participantAId String
  participantBId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  imageUri       String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
